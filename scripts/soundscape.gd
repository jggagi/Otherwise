extends Node
## Small local audio layer. All WAVs are generated by generate_audio.py.
var rain: AudioStreamPlayer
var effects: AudioStreamPlayer
var volume: float = 0.65
var foot_timer: float = 0.0

func _ready() -> void:
	rain = AudioStreamPlayer.new()
	var stream: AudioStreamWAV = load("res://assets/audio/rain.wav")
	stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	stream.loop_end = stream.data.size() / 2
	rain.stream = stream
	rain.volume_db = -8.0
	add_child(rain)
	rain.play()
	effects = AudioStreamPlayer.new()
	effects.volume_db = -10.0
	add_child(effects)
	set_volume(volume)

func cue(id: String) -> void:
	var path := "res://assets/audio/%s.wav" % id
	if ResourceLoader.exists(path):
		effects.stream = load(path)
		effects.play()

func walking(delta: float, moving: bool) -> void:
	if not moving:
		foot_timer = 0.0
		return
	foot_timer += delta
	if foot_timer > 0.42:
		foot_timer = 0.0
		cue("step")

func set_volume(value: float) -> void:
	volume = clampf(value, 0.0, 1.0)
	AudioServer.set_bus_volume_db(0, linear_to_db(maxf(volume, 0.0001)))
	AudioServer.set_bus_mute(0, volume < 0.001)

func _exit_tree() -> void:
	stop_all()

func stop_all() -> void:
	# Release looping playback before the audio device closes (also on dummy driver).
	if is_instance_valid(rain):
		rain.stop()
		rain.stream = null
	if is_instance_valid(effects):
		effects.stop()
		effects.stream = null
