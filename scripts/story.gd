extends RefCounted
## Authored content only. Reading a line never mutates gameplay state.

static func line(who: String, text: String, pose: String = "", event: String = "") -> Dictionary:
	return {"who": who, "text": text, "pose": pose, "event": event}

static func opening() -> Array:
	return [
		line("", "雨从下班时一直落到现在。你把钥匙放下，屋里只有那盏落地灯还亮着。"),
		line("", "桌上压着一封普通的纸信。你已经把‘明天再拆’说了好几天。"),
		line("", "墙上的合影还在。照片里的人比现在更习惯站得近一些。"),
		line("你", "先换掉湿衣服吧。今晚应该不会再有人找我。"),
		line("", "手机震了一下。一个很久没有在这个时间出现的名字，停在屏幕上。", "", "phone_arrived"),
		line("", "你可以先走走，也可以直接查看茶几上的手机。WASD／方向键移动，E 交互；点击地面也能走过去。")
	]

static func branch(choice: int, simulated: bool) -> Array:
	var lines: Array = []
	match choice:
		1:
			lines = [
				line("", "你走到门口，拿上外套。单元门外的风把雨吹到台阶里面。", "corridor"),
				line("", "林夏站在灯下，伞收着。看见你，她先笑了一下，又把那点笑收回去。", "standing"),
				line("你", "怎么不撑伞？"),
				line("林夏", "刚才雨小。我以为你会很快下来。"),
				line("你", "你可以先发消息。"),
				line("林夏", "我发了。又删了几次。最后觉得，站到这里可能比较容易开口。", "phone"),
				line("", "她低头看了一眼手机，却没有把屏幕朝向你。雨顺着伞尖滴在鞋边。"),
				line("林夏", "明天……你能陪我去车站吗？就这一次。"),
				line("你", "你要出门？"),
				line("林夏", "要离开这里。已经定好了。不是来让你替我决定的。"),
				line("", "你想问什么时候决定的，又觉得这句话听起来像在责怪她没有先告诉你。"),
				line("你", "明早几点？"),
				line("林夏", "七点。你不用现在答应。回去看看安排，晚一点再告诉我。"),
				line("你", "你今天来，就为了问这个？"),
				line("林夏", "如果只问这个，在手机上也可以问。"),
				line("", "她把话停在这里。你们都知道还有一句，但谁也没有替对方说出来。"),
				line("林夏", "以前你说，雨停了再走。后来雨停的时候，我们又忙别的去了。"),
				line("你", "我没有忘。"),
				line("林夏", "我知道。忘了反而容易。"),
				line("", "你接过她递来的收拢的伞，答应今晚会给她一个明确的回复。"),
				line("林夏", "这次别只回一个‘好’。我会不知道那个好，是答应还是知道了。"),
				line("", "回到房间，伞靠在门边。你的决定留下了痕迹，接下来的答复还没有发生。", "empty")
			]
		2:
			lines = [
				line("你", "上来吧。", "entry"),
				line("", "两分钟后，门外有很轻的敲门声。你打开门，林夏站在门口，把伞尖挪开，避免水滴进屋。", "standing"),
				line("林夏", "鞋放这里还可以吗？"),
				line("你", "可以。你以前一直放这里。"),
				line("", "说完你才发现，‘以前’两个字已经被你们放在许多句子的开头。"),
				line("", "她坐在沙发的边上，没有靠下去。你倒了两杯水。", "seated"),
				line("林夏", "这只杯子你还留着。"),
				line("你", "又没坏。"),
				line("林夏", "是。东西没坏，就好像不用再想它。"),
				line("", "她的手机一直扣在桌面上。屏幕亮了一次，她把手压了上去，没有查看。"),
				line("你", "你是不是有什么事？"),
				line("林夏", "明早七点的车。我想换个地方住一阵。"),
				line("你", "什么时候决定的？"),
				line("林夏", "决定了很久。告诉你，倒是拖到了今天。"),
				line("", "你把杯子推近一点。她握住杯沿，好像终于找到一个不用看着你也能继续说话的姿势。"),
				line("林夏", "我不是要你拦我。只是出门之前，想把话说完整。"),
				line("你", "那你说。我在听。"),
				line("林夏", "以前我说‘没事’，你就真的放心了。有时我又怪你放心。这样对你也不公平。"),
				line("你", "我也总觉得，等我们不那么累的时候，什么都能说明白。"),
				line("林夏", "可能不会有那个刚好不累的晚上。"),
				line("", "门外的雨声变密。她起身，把手机翻回来，放进口袋。", "standing"),
				line("林夏", "明天能不能陪我去车站，你想好了再告诉我。今晚说也来得及。"),
				line("", "她离开后，桌上多了一只杯子，门边多了一双刚才换下的备用鞋和湿伞。你们没有约定留下，却也没有把告别说完。", "empty")
			]
		3:
			lines = [
				line("", "你把手机放回桌上。屏幕熄灭后，屋里看起来和一分钟前一样。", "empty"),
				line("你", "等一下再回。"),
				line("", "你走到窗边。楼下的灯被雨水拉成很长的线，看不清哪个影子是她。"),
				line("", "十分钟过去。门外有脚步停了一下，随后沿楼梯向下远去。"),
				line("", "你终于拿起手机，没有新的消息。原来沉默也会让一段对话往前走。"),
				line("你", "她回去了吧。"),
				line("", "你开门看了一眼。门边有一张折过的纸，边角被雨浸软。"),
				line("字条", "其实我明天要离开这里。七点的车。"),
				line("字条", "我在路上练了几遍，想当面说。到了楼下，又觉得也许你不想听。"),
				line("字条", "你不用为了我改变明天的安排。但如果愿意陪我走到车站，今晚告诉我就好。"),
				line("", "下面还有一行，写得轻一些。"),
				line("字条", "如果不行，也请告诉我。这样我明早就不会一直看手机。"),
				line("你", "她不是来问一个可以一直不回答的问题。"),
				line("", "纸背没有字。你翻过来，又翻回去，像这样还能找到她没有写出来的那句。"),
				line("", "时间还没有走到明天。你仍然可以联系她，只是不能假装刚才的沉默没有发生。"),
				line("", "你把字条留在门边晾着。手机握在手里，还是没有拨出去。")
			]
	if simulated:
		lines.append(line("", "在这条被重构的可能里，她还提到了一件很小的事。"))
		lines.append(line("林夏" if choice != 3 else "字条", "你书柜最下面那层，左边那本旧书后面，还有我的发圈。", "phone" if choice != 3 else "empty", "shelf_hint"))
		lines.append(line("林夏" if choice != 3 else "字条", "不是新的那个。断过一次，我用蓝线把里面的接口缝住了。"))
		lines.append(line("你", "我从来没见过这个东西。她什么时候放的？"))
		lines.append(line("", "ELSE 没有读取过书柜，也没有收到任何提到发圈的记录。画面里，一次雨声像复制过一样重复。"))
		lines.append(line("", "重构到此结束。你将回到原本的房间；这里的物品和答复不会成为现实。", "empty"))
	return lines

static func verify() -> Array:
	return [
		line("", "你按照那句话，把最下层左边那本书向外挪了一点。"),
		line("", "纸页后面压着一枚旧发圈。颜色已经褪了，里面的接口缝着一小截蓝线。", "", "tie_verified"),
		line("你", "它原来就在这里。不是刚才才出现的。"),
		line("", "你回看 ELSE 的输入记录。近期消息、日历、几条随手写的笔记。没有书架照片，没有这枚发圈。"),
		line("你", "也许我遗漏了什么。可为什么连那截蓝线都一样？"),
		line("", "你没有把发圈当成答案带走。它仍留在书背后，而那句话已经无法从记忆里删掉。"),
		line("你", "她今晚一直在说‘明天’。我却一直在猜，她是不是在责怪今晚的我。"),
		line("", "你愿意记住的理解，不是另一个世界发生了什么，而是她为什么迟迟没有把那句话说完。", "", "anchor_ready")
	]

static func final_call(anchored: bool) -> Array:
	var lines: Array = [
		line("", "你拨通了林夏的电话。铃声响了两次。房间里的东西没有被重构改写，之前的选择仍是你作出的。", "empty"),
		line("林夏", "喂。"),
		line("你", "是我。刚才的事，我想继续说。"),
		line("林夏", "我在听。", "phone")
	]
	if anchored:
		lines.append(line("你", "明天离开之前，你还想和我说什么？"))
		lines.append(line("林夏", "我以为你会先问，为什么不早点告诉你。"))
		lines.append(line("你", "我刚才确实想问。现在想先听你说。"))
		lines.append(line("林夏", "我有点怕。不是怕换一个地方，是怕等车的时候，忽然觉得我们最后只剩下几个没有回的消息。"))
		lines.append(line("你", "我以为你是在生气。"))
		lines.append(line("林夏", "也有。但不是全部。"))
	else:
		lines.append(line("你", "我知道你明早要走。你现在还好吗？"))
		lines.append(line("林夏", "还有一些东西没收。我一直在检查有没有落下，其实知道已经收得差不多了。"))
		lines.append(line("你", "如果还有话想说，今晚我可以听。"))
		lines.append(line("林夏", "我想说的不是要你改变什么。就是别再让我们自己猜对方的意思了。"))
	lines.append(line("你", "有些话我也拖了很久。因为说了，就不能再假装什么都没发生。"))
	lines.append(line("林夏", "是。我也是。"))
	lines.append(line("", "窗外有一辆车驶过。两个人都等那阵水声过去，才继续开口。"))
	lines.append(line("林夏", "你不用给我一个听起来很好的答复。给我一个真的就行。"))
	return lines

static func ending(response: int, anchored: bool) -> Array:
	var lines: Array = []
	if response == 1:
		lines = [
			line("你", "明早我陪你去车站。六点四十，我在楼下等你。"),
			line("林夏", "你确定吗？不用因为不好意思拒绝。"),
			line("你", "确定。我不能替你决定去哪儿，但可以陪你把这段路走完。"),
			line("林夏", "好。那这次，我会直接走到你面前。"),
			line("", "通话没有立刻结束。你们又说了几件很普通的事：行李有没有带伞，明早哪里可以买到热水。"),
			line("你", "我会带伞。"),
			line("林夏", "这次别等雨停了。"),
			line("", "放下手机，你把闹钟调到六点，把伞放在门边。答应陪她离开，不等于一切恢复原样。"),
			line("", "天将亮时，楼下的路面还湿着。你站在那里，看见林夏拎着箱子从门里出来。"),
			line("林夏", "早。"),
			line("你", "早。走吧。")
		]
	else:
		lines = [
			line("你", "明早我不能陪你去车站。我不想先答应，再让你一直等。"),
			line("", "电话那边静了一小会儿。你没有用更多理由填满它。"),
			line("林夏", "好。谢谢你现在告诉我。"),
			line("你", "但如果你愿意，今晚我们把没说完的话说完。"),
			line("林夏", "我愿意。"),
			line("", "你们说起那张一直挂着的照片，也说起那些以为以后总能补上的解释。没有谁把过去重新改成正确的样子。"),
			line("你", "我不会说‘有空再聊’来结束今晚。到了那边，报个平安吧。"),
			line("林夏", "会的。不是因为还欠你一个答复，是因为我想告诉你。"),
			line("", "放下手机，你将桌上的第二只杯子或手边的纸收好。告别仍然发生，但它终于不是一段无人确认的沉默。"),
			line("", "天亮时，手机上有一条短消息。"),
			line("林夏", "上车了。雨停了。")
		]
	if anchored:
		lines.append(line("", "电脑没有发出声音。屏幕上仍是那份有限的输入记录。你关掉 ELSE，书背后的蓝线却已经成为现实中无法解释的细节。"))
	lines.append(line("", "你没有得到另一种人生。你只是终于决定，接下来这一句话，自己来说。", "empty"))
	return lines
